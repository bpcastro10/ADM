# =============================================================================
# Configuración de IA — GPT-5.4 en Azure OpenAI (activo)
# =============================================================================

AI_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://TU-RECURSO.openai.azure.com/
AZURE_OPENAI_API_KEY=tu-api-key-azure
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-5-4-eval

AI_TIMEOUT=300
JSON_SERVER_URL=http://localhost:3000

# =============================================================================
# Alternativas — no usadas con GPT-5.4 (descomenta solo si cambias de modelo)
# =============================================================================

